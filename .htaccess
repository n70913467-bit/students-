Options -Indexes

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "same-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Private application storage must never be served as static files.
  RewriteRule ^storage(?:/|$) - [F,NC,L]
  # Do not expose source-control metadata, tests, deployment templates or docs.
  RewriteRule ^(?:\.git|\.github|docs|tests|deployment)(?:/|$) - [F,NC,L]
  RewriteRule ^(?:README\.md|schema\.sql|Dockerfile|docker-compose\.yml|package\.json|router\.php)$ - [F,NC,L]
  RewriteRule (^|/)\.(?!well-known(?:/|$)) - [F,NC,L]
  RewriteRule ^api/?$ api.php?route=health [QSA,L]
  RewriteRule ^api/(.*)$ api.php?route=$1 [QSA,L]
</IfModule>
